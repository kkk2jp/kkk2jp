---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { getCategoryColor, getCategoryIcon, getCategoryLabel, SITE_TITLE } from '../../consts';

const PAGE_SIZE = 10;

export async function getStaticPaths() {
	const PAGE_SIZE = 10;
	const posts = await getCollection('blog');
	const categories = [...new Set(posts.map((p) => p.data.category))];

	return categories.flatMap((category) => {
		const catPosts = posts
			.filter((p) => p.data.category === category)
			.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
		const totalPages = Math.ceil(catPosts.length / PAGE_SIZE);
		return Array.from({ length: totalPages - 1 }, (_, i) => ({
			params: { category, pagenum: String(i + 2) },
			props: { posts: catPosts, totalPages },
		}));
	});
}

const { category, pagenum } = Astro.params;
const { posts, totalPages } = Astro.props;
const currentPage = Number(pagenum);
const label = getCategoryLabel(category);
const icon = getCategoryIcon(category);
const accent = getCategoryColor(category);
const pagePosts = posts.slice((currentPage - 1) * PAGE_SIZE, currentPage * PAGE_SIZE);
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead
			title={`${label} (${currentPage}ページ目) | ${SITE_TITLE}`}
			description={`${label}の記事一覧 ${currentPage}ページ目`}
		/>
		<style>
			main { width: 960px; }
		</style>
	</head>
	<body>
		<Header />
		<main>
			<a class="back-link" href="/">← トップに戻る</a>
			<div class="page-header" style={`--cat: ${accent}`}>
				<h1>
					<span class="cat-chip">
						<span class="material-symbols-outlined" aria-hidden="true">{icon}</span>
					</span>
					{label}
				</h1>
				<p class="count">{posts.length}件の記事</p>
			</div>

			<ul class="post-list">
				{pagePosts.map((post) => {
					const parts = post.id.split('/');
					const slug = parts.slice(1).join('/');
					return (
						<li>
							<a href={`/${category}/${slug}/`}>
								<div class="post-thumb" style={`--cat: ${accent}`}>
									<span class="material-symbols-outlined" aria-hidden="true">{icon}</span>
								</div>
								<div class="post-info">
									<h2>{post.data.title}</h2>
									<p class="date"><FormattedDate date={post.data.pubDate} /></p>
								</div>
							</a>
						</li>
					);
				})}
			</ul>

			<nav class="pagination" aria-label="ページネーション">
				{currentPage > 1
					? <a href={currentPage === 2 ? `/${category}/` : `/${category}/${currentPage - 1}/`}>← 前へ</a>
					: <span class="disabled">← 前へ</span>
				}
				{Array.from({ length: totalPages }, (_, i) => i + 1).map((p) =>
					p === currentPage
						? <span class="current">{p}</span>
						: <a href={p === 1 ? `/${category}/` : `/${category}/${p}/`}>{p}</a>
				)}
				{currentPage < totalPages
					? <a href={`/${category}/${currentPage + 1}/`}>次へ →</a>
					: <span class="disabled">次へ →</span>
				}
			</nav>
		</main>
		<Footer />
	</body>
</html>
