---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { CATEGORY_ORDER, getCategoryColor, getCategoryIcon, getCategoryLabel, SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const allPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const latestPosts = allPosts.slice(0, 10);
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main { width: 960px; }

			/* ── Category tiles ── */
			.category-tiles {
				display: grid;
				grid-template-columns: repeat(4, 1fr);
				gap: 16px;
				margin-bottom: 48px;
			}
			/* --cat（カテゴリのアクセント色）から淡い背景・枠線を自動生成 */
			.category-tile {
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 10px;
				padding: 28px 16px 24px;
				border-radius: 16px;
				border: 1px solid color-mix(in srgb, var(--cat, var(--md-outline-variant)) 28%, #fff);
				text-decoration: none;
				color: var(--md-on-surface);
				background: color-mix(in srgb, var(--cat, var(--md-surface)) 6%, #fff);
				transition: background 0.15s, box-shadow 0.15s;
			}
			.category-tile:hover {
				background: color-mix(in srgb, var(--cat, var(--md-surface)) 12%, #fff);
				box-shadow: var(--box-shadow);
				text-decoration: none;
			}
			.category-tile .material-symbols-outlined {
				font-size: 40px;
				color: var(--cat, var(--md-primary));
			}
			.category-tile-name {
				font-size: 0.9rem;
				font-weight: 600;
				text-align: center;
			}

			/* ── Section header ── */
			.section-header {
				font-size: 1.125rem;
				font-weight: 700;
				margin: 0 0 16px;
				padding-bottom: 12px;
				border-bottom: 2px solid var(--md-primary);
			}

			/* ── Category badges ── */
			.category-badge {
				display: inline-flex;
				align-items: center;
				gap: 3px;
				padding: 2px 8px;
				border-radius: 9999px;
				font-size: 0.72rem;
				font-weight: 600;
				white-space: nowrap;
				flex-shrink: 0;
			}
			.category-badge .material-symbols-outlined { font-size: 11px; }
			/* --cat から淡い背景 + アクセント文字色を自動生成 */
			.category-badge {
				background: color-mix(in srgb, var(--cat, var(--md-primary)) 12%, #fff);
				color: var(--cat, var(--md-primary));
			}

			/* meta row inside post-info */
			.post-meta {
				display: flex;
				align-items: center;
				gap: 8px;
				flex-wrap: wrap;
				margin-top: 4px;
			}
			.post-meta .date { margin: 0; }

			/* ── See all ── */
			.see-all {
				display: block;
				text-align: center;
				margin-top: 8px;
				font-size: 0.9375rem;
				font-weight: 500;
				color: var(--md-primary);
				text-decoration: none;
			}
			.see-all:hover { text-decoration: underline; }

			@media (max-width: 640px) {
				.category-tiles { grid-template-columns: repeat(2, 1fr); }
				.post-list .post-thumb { width: 56px; height: 42px; }
				.post-list .post-thumb .material-symbols-outlined { font-size: 22px; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<!-- Category tiles -->
			<div class="category-tiles">
				{CATEGORY_ORDER.map((cat) => (
					<a class="category-tile" style={`--cat: ${getCategoryColor(cat)}`} href={`/${cat}/`}>
						<span class="material-symbols-outlined" aria-hidden="true">
							{getCategoryIcon(cat)}
						</span>
						<span class="category-tile-name">{getCategoryLabel(cat)}</span>
					</a>
				))}
			</div>

			<!-- Latest posts -->
			<h2 class="section-header">最新の記事</h2>
			<ul class="post-list">
				{latestPosts.map((post) => {
					const parts = post.id.split('/');
					const cat = parts[0];
					const slug = parts.slice(1).join('/');
					return (
						<li>
							<a href={`/${cat}/${slug}/`}>
								<div class="post-thumb" style={`--cat: ${getCategoryColor(cat)}`}>
									<span class="material-symbols-outlined" aria-hidden="true">
										{getCategoryIcon(cat)}
									</span>
								</div>
								<div class="post-info">
									<h3>{post.data.title}</h3>
									<div class="post-meta">
										<span class="category-badge" style={`--cat: ${getCategoryColor(cat)}`}>
											<span class="material-symbols-outlined" aria-hidden="true">
												{getCategoryIcon(cat)}
											</span>
											{getCategoryLabel(cat)}
										</span>
										<p class="date"><FormattedDate date={post.data.pubDate} /></p>
									</div>
								</div>
							</a>
						</li>
					);
				})}
			</ul>

			<a class="see-all" href="/posts/">すべての記事を見る →</a>
		</main>
		<Footer />
	</body>
</html>
