---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { CATEGORY_ORDER, getCategoryColor, getCategoryIcon, getCategoryLabel, SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const allPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const latestPosts = allPosts.slice(0, 10);
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main { width: 960px; }

			/* ── Lead ── */
			.site-lead {
				margin: 0 0 28px;
				font-size: 0.9375rem;
				color: var(--md-on-surface-variant);
			}

			/* ── Category tiles ── */
			.category-tiles {
				display: grid;
				grid-template-columns: repeat(4, 1fr);
				gap: 14px;
				margin-bottom: 56px;
			}
			/* --cat（カテゴリのアクセント色）はインラインで供給される */
			.category-tile {
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 12px;
				padding: 24px 16px 20px;
				border-radius: var(--radius-l);
				border: 1px solid var(--md-outline-variant);
				text-decoration: none;
				color: var(--md-on-surface);
				background: var(--md-surface);
				transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
			}
			.category-tile:hover {
				transform: translateY(-3px);
				box-shadow: var(--box-shadow);
				border-color: color-mix(in srgb, var(--cat, var(--md-outline)) 40%, #fff);
				text-decoration: none;
			}
			.tile-icon {
				display: flex;
				align-items: center;
				justify-content: center;
				width: 52px;
				height: 52px;
				border-radius: 14px;
				background: color-mix(in srgb, var(--cat, var(--md-primary)) 10%, #fff);
				border: 1px solid color-mix(in srgb, var(--cat, var(--md-primary)) 20%, #fff);
			}
			.tile-icon .material-symbols-outlined {
				font-size: 28px;
				color: var(--cat, var(--md-primary));
			}
			.category-tile-name {
				font-size: 0.875rem;
				font-weight: 600;
				text-align: center;
			}

			/* ── See all ── */
			.see-all {
				display: flex;
				align-items: center;
				justify-content: center;
				width: fit-content;
				margin: 16px auto 0;
				padding: 10px 24px;
				border-radius: 9999px;
				border: 1px solid var(--md-outline-variant);
				background: var(--md-surface);
				font-size: 0.9rem;
				font-weight: 600;
				color: var(--md-on-surface);
				text-decoration: none;
				transition: background 0.15s, border-color 0.15s, box-shadow 0.15s;
			}
			.see-all:hover {
				border-color: var(--md-outline);
				box-shadow: var(--box-shadow-s);
				text-decoration: none;
			}

			@media (max-width: 640px) {
				.category-tiles { grid-template-columns: repeat(2, 1fr); }
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<p class="site-lead">{SITE_DESCRIPTION}</p>

			<!-- Category tiles -->
			<div class="category-tiles">
				{CATEGORY_ORDER.map((cat) => (
					<a class="category-tile" style={`--cat: ${getCategoryColor(cat)}`} href={`/${cat}/`}>
						<span class="tile-icon">
							<span class="material-symbols-outlined" aria-hidden="true">
								{getCategoryIcon(cat)}
							</span>
						</span>
						<span class="category-tile-name">{getCategoryLabel(cat)}</span>
					</a>
				))}
			</div>

			<!-- Latest posts -->
			<h2 class="section-header">最新の記事</h2>
			<ul class="post-list">
				{latestPosts.map((post) => {
					const parts = post.id.split('/');
					const cat = parts[0];
					const slug = parts.slice(1).join('/');
					return (
						<li>
							<a href={`/${cat}/${slug}/`}>
								<div class="post-thumb" style={`--cat: ${getCategoryColor(cat)}`}>
									<span class="material-symbols-outlined" aria-hidden="true">
										{getCategoryIcon(cat)}
									</span>
								</div>
								<div class="post-info">
									<h3>{post.data.title}</h3>
									<div class="post-meta">
										<span class="category-badge" style={`--cat: ${getCategoryColor(cat)}`}>
											<span class="material-symbols-outlined" aria-hidden="true">
												{getCategoryIcon(cat)}
											</span>
											{getCategoryLabel(cat)}
										</span>
										<p class="date"><FormattedDate date={post.data.pubDate} /></p>
									</div>
								</div>
							</a>
						</li>
					);
				})}
			</ul>

			<a class="see-all" href="/posts/">すべての記事を見る →</a>
		</main>
		<Footer />
	</body>
</html>
