---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { getCategoryColor, getCategoryIcon, getCategoryLabel, SITE_TITLE } from '../../consts';

const allPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={`すべての記事 | ${SITE_TITLE}`} description="全記事一覧" />
		<style>
			main { width: 960px; }
		</style>
	</head>
	<body>
		<Header />
		<main>
			<a class="back-link" href="/">← トップに戻る</a>
			<div class="page-header">
				<h1>すべての記事</h1>
				<p class="count">{allPosts.length}件の記事</p>
			</div>

			<ul class="post-list">
				{allPosts.map((post) => {
					const parts = post.id.split('/');
					const cat = parts[0];
					const slug = parts.slice(1).join('/');
					return (
						<li>
							<a href={`/${cat}/${slug}/`}>
								<div class="post-thumb" style={`--cat: ${getCategoryColor(cat)}`}>
									<span class="material-symbols-outlined" aria-hidden="true">
										{getCategoryIcon(cat)}
									</span>
								</div>
								<div class="post-info">
									<h2>{post.data.title}</h2>
									<div class="post-meta">
										<span class="category-badge" style={`--cat: ${getCategoryColor(cat)}`}>
											<span class="material-symbols-outlined" aria-hidden="true">
												{getCategoryIcon(cat)}
											</span>
											{getCategoryLabel(cat)}
										</span>
										<p class="date"><FormattedDate date={post.data.pubDate} /></p>
									</div>
								</div>
							</a>
						</li>
					);
				})}
			</ul>
		</main>
		<Footer />
	</body>
</html>
