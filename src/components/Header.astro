---
import { SITE_TITLE } from '../consts';
import ShimejiMark from './ShimejiMark.astro';
---

<header>
	<nav>
		<a class="site-title" href="/">
			<ShimejiMark size={22} />
			{SITE_TITLE}
		</a>

		<div class="header-right">
			<a href="https://x.com/kkk2jp" target="_blank" rel="noopener" aria-label="Twitter/X" class="social-link">
				<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
					<path d="M14.234 10.162 22.977 0h-2.072l-7.591 8.824L7.251 0H.258l9.168 13.343L.258 24H2.33l8.016-9.318L16.749 24h6.993zm-2.837 3.299-.929-1.329L3.076 1.56h3.182l5.965 8.532.929 1.329 7.754 11.09h-3.182z"/>
				</svg>
			</a>
			<a href="https://note.com/kkk2jp" target="_blank" rel="noopener" aria-label="note" class="social-link">
				<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
					<path d="M0 .279c4.623 0 10.953-.235 15.498-.117 6.099.156 8.39 2.813 8.468 9.374.077 3.71 0 14.335 0 14.335h-6.598c0-9.296.04-10.83 0-13.759-.078-2.578-.814-3.807-2.795-4.041-2.097-.235-7.975-.04-7.975-.04v17.84H0Z"/>
				</svg>
			</a>
		</div>
	</nav>
</header>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 100;
		/* ページ背景と同系色にして真っ白な帯感をなくす */
		background: color-mix(in srgb, var(--md-background) 80%, transparent);
		-webkit-backdrop-filter: blur(12px) saturate(1.5);
		backdrop-filter: blur(12px) saturate(1.5);
		border-bottom: 1px solid var(--md-outline-variant);
	}
	nav {
		max-width: 960px;
		margin: auto;
		padding: 0 16px;
		height: 60px;
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	.site-title {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		font-family: var(--font-display);
		font-size: 1.3125rem;
		font-weight: 700;
		color: var(--md-on-surface);
		text-decoration: none;
		letter-spacing: -0.02em;
		white-space: nowrap;
		flex-shrink: 0;
	}
	.site-title:hover { text-decoration: none; opacity: 0.75; transition: opacity 0.15s; }

	.header-right {
		display: flex;
		align-items: center;
		gap: 4px;
		flex-shrink: 0;
	}
	.social-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		border-radius: 9999px;
		color: var(--md-on-surface-variant);
		transition: background 0.15s, color 0.15s;
	}
	.social-link:hover { background: var(--md-surface-variant); color: var(--md-on-surface); text-decoration: none; }
</style>
