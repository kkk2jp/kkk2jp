---
/**
 * ブランドマーク「しめじ」（1本）。
 * ヘッダー・フッターで使用。favicon（public/favicon.svg）・OGロゴ
 * （src/assets/shimeji-mark.png）も同じデザインなので、
 * 変更する場合は3か所を揃えること。
 */
interface Props {
	/** 表示サイズ(px) */
	size?: number;
}
const { size = 20 } = Astro.props;
---

<svg
	width={size}
	height={size}
	viewBox="0 0 64 64"
	xmlns="http://www.w3.org/2000/svg"
	aria-hidden="true"
	class="shimeji-mark"
>
	<!-- タイル -->
	<rect width="64" height="64" rx="14" fill="#1B1B1B" />
	<!-- 軸 -->
	<path d="M25 32 h14 v14 a7 7 0 0 1 -7 7 a7 7 0 0 1 -7 -7 z" fill="#F1E8DA" />
	<!-- カサ -->
	<path
		d="M32 11 C 20.5 11 13 19 13 27.5 C 13 31.5 16 34 20 34 L 44 34 C 48 34 51 31.5 51 27.5 C 51 19 43.5 11 32 11 Z"
		fill="#A57D57"
	/>
	<!-- ハイライト -->
	<ellipse cx="24.5" cy="20" rx="5" ry="3.4" fill="#FFFFFF" opacity="0.22" transform="rotate(-22 24.5 20)" />
</svg>

<style>
	.shimeji-mark { flex-shrink: 0; display: block; }
</style>
