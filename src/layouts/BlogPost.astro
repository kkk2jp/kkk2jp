---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { getCategoryColor, getCategoryIcon, getCategoryLabel } from '../consts';

type Props = CollectionEntry<'blog'>['data'] & {
	/** ビルド時生成のOGP画像パス（サイトルート基準） */
	ogImage?: string;
};

const { title, description, pubDate, updatedDate, category, ogImage } = Astro.props;
---

<html lang="ja">
	<head>
		<BaseHead title={title} description={description} image={ogImage} />
		<style>
			.prose {
				margin: 0 auto;
				padding: 0 0 80px;
				color: var(--md-on-surface);
			}
			.article-header {
				margin-bottom: 44px;
				padding-bottom: 28px;
				border-bottom: 1px solid var(--md-outline-variant);
			}
			.article-meta {
				display: flex;
				align-items: center;
				gap: 12px;
				margin-bottom: 18px;
				flex-wrap: wrap;
			}
			.date {
				font-size: 0.875rem;
				color: var(--md-on-surface-variant);
			}
			.last-updated {
				font-size: 0.8rem;
				color: var(--md-on-surface-variant);
			}
			.article-header h1 {
				font-size: 2.125rem;
				line-height: 1.4;
				margin: 0;
			}
			@media (max-width: 720px) {
				.article-header h1 { font-size: 1.625rem; }
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="prose">
					<div class="article-header">
						<div class="article-meta">
							{category && (
								<a
									class="category-badge"
									style={`--cat: ${getCategoryColor(category)}`}
									href={`/${category}/`}
								>
									<span class="material-symbols-outlined" aria-hidden="true">
										{getCategoryIcon(category)}
									</span>
									{getCategoryLabel(category)}
								</a>
							)}
							<span class="date"><FormattedDate date={pubDate} /></span>
							{updatedDate && (
								<span class="last-updated">
									更新: <FormattedDate date={updatedDate} />
								</span>
							)}
						</div>
						<h1>{title}</h1>
					</div>
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
